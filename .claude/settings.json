{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "R=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [ -n \"$R\" ] && [ -x \"$R/ops/hooks/claude-sessionstart.sh\" ] && \"$R/ops/hooks/claude-sessionstart.sh\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "R=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [ -n \"$R\" ] && [ -x \"$R/ops/hooks/claude-stop.sh\" ] && \"$R/ops/hooks/claude-stop.sh\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "R=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [ -n \"$R\" ] && [ -x \"$R/ops/hooks/claude-pretooluse.sh\" ] && \"$R/ops/hooks/claude-pretooluse.sh\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "R=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [ -n \"$R\" ] && [ -x \"$R/ops/hooks/claude-posttooluse.sh\" ] && \"$R/ops/hooks/claude-posttooluse.sh\"; exit 0",
            "timeout": 60,
            "statusMessage": "Checking test baseline..."
          }
        ]
      }
    ]
  }
}
